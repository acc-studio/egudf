{
  "name": "egudf",
  "version": "0.17.0",
  "description": "egUDF — UYAP .udf editor with e-imza signing",
  "main": "main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.js",
    "smoke": "npm run build && electron . --smoke=test/.out",
    "smoke:packaged": "npm run build && electron-builder --dir --publish never && release\\win-unpacked\\egUDF.exe --smoke=test/.pkg",
    "rebuild": "electron-rebuild -f -w pkcs11js",
    "dist": "npm run build && electron-builder --publish never",
    "postinstall": "electron-rebuild -f -w pkcs11js"
  },
  "author": "Aziz Can Cengiz",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "hunspell-asm": "^4.0.2",
    "pkcs11js": "^2.1.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-highlight": "^3.33.1",
    "@tiptap/extension-paragraph": "^3.33.1",
    "@tiptap/extension-subscript": "^3.33.1",
    "@tiptap/extension-superscript": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extension-text-style": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@xmldom/xmldom": "^0.9.12",
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1"
  },
  "productName": "egUDF",
  "build": {
    "appId": "com.azizcancengiz.udfeditor",
    "productName": "egUDF",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "index.html",
      "src/styles.css",
      "build/icon.png",
      "sign/**",
      "dist/**",
      "assets/**",
      "node_modules/pkcs11js/**",
      "lib/**"
    ],
    "asarUnpack": [
      "node_modules/pkcs11js/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "build/installer.nsh"
    },
    "fileAssociations": [
      {
        "ext": "udf",
        "name": "UYAP Document",
        "description": "UYAP Doküman",
        "role": "Editor"
      }
    ]
  }
}
